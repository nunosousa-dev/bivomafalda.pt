---
import Icon from './Icon.astro';
import { discoverPages, pages } from '../data/site';
interface Props { path: string }
const { path } = Astro.props;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Casa da Bivó Mafalda — início">
      <span>Casa da</span>
      <strong>Bivó Mafalda<span class="wordmark-dot">.</span></strong>
    </a>
    <nav class="desktop-nav" aria-label="Navegação principal">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Início</a>
      <details class="discover-menu" data-active={path.startsWith('/descobrir/')}>
        <summary>Descobrir <Icon name="chevron" size={14} /></summary>
        <div class="discover-links">
          {discoverPages.map((page) => <a href={page.href} aria-current={path === page.href ? 'page' : undefined}>{page.title}</a>)}
        </div>
      </details>
      <a href="/galeria.html" aria-current={path === '/galeria.html' ? 'page' : undefined}>Galeria</a>
      <a href="/precos.html" aria-current={path === '/precos.html' ? 'page' : undefined}>Preços</a>
      <a class="button button-small" href="/contactos.html" aria-current={path === '/contactos.html' ? 'page' : undefined}>Contactos <Icon name="diagonal" size={16} /></a>
    </nav>
    <details class="mobile-nav">
      <summary><span>Menu</span><Icon name="menu" /></summary>
      <nav aria-label="Navegação móvel">
        {pages.map((page) => <a href={page.href} aria-current={path === page.href ? 'page' : undefined}>{page.title}<Icon name="arrow" size={18} /></a>)}
      </nav>
    </details>
  </div>
</header>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>('.site-header details');
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus) {
      if (menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    }
  });
  document.addEventListener('click', (event) => {
    for (const menu of menus) {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    }
  });
</script>

<style>
  .site-header { position: relative; z-index: 20; background: var(--paper); }
  .header-inner { min-height: 108px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .wordmark { display: grid; color: var(--pine); text-decoration: none; line-height: 1.1; flex-shrink: 0; }
  .wordmark > span { font-size: .73rem; font-weight: 600; margin-bottom: .3rem; }
  .wordmark strong { font-family: var(--font-display); font-size: 1.85rem; font-weight: 400; letter-spacing: -.035em; }
  .wordmark-dot { color: var(--moss); }
  .desktop-nav { display: flex; align-items: center; gap: 2rem; font-size: .83rem; font-weight: 600; }
  .desktop-nav > a:not(.button) { padding-block: .6rem; text-decoration: none; }
  .desktop-nav a[aria-current='page']:not(.button) { text-decoration: underline; text-underline-offset: .5em; }
  .discover-menu { position: relative; }
  summary { display: flex; align-items: center; gap: .45rem; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .discover-menu summary { padding-block: .6rem; }
  .discover-menu[data-active='true'] summary { text-decoration: underline; text-underline-offset: .5em; }
  .discover-menu[open] summary :global(svg) { transform: rotate(180deg); }
  .discover-links { position: absolute; top: calc(100% + .8rem); left: -1.5rem; min-width: 240px; padding: .6rem; background: var(--paper); box-shadow: var(--shadow); border-radius: var(--radius); }
  .discover-links a { display: block; padding: .85rem 1rem; text-decoration: none; border-radius: 6px; }
  .discover-links a:hover { background: var(--mist); }
  .mobile-nav { display: none; }
  @media (max-width: 800px) {
    .header-inner { min-height: 88px; gap: 1rem; }
    .wordmark strong { font-size: 1.5rem; }
    .desktop-nav { display: none; }
    .mobile-nav { display: block; }
    .mobile-nav > summary { min-height: 44px; padding: .5rem 0 .5rem .75rem; font-size: .8rem; font-weight: 600; }
    .mobile-nav nav { position: absolute; top: 100%; inset-inline: 0; padding: .75rem var(--gutter) 1.5rem; background: var(--paper); box-shadow: 0 18px 24px rgb(22 57 43 / .1); }
    .mobile-nav nav a { display: flex; align-items: center; justify-content: space-between; padding: .9rem 0; border-top: 1px solid var(--line); font-size: .9rem; text-decoration: none; }
    .mobile-nav nav a[aria-current='page'] { font-weight: 700; }
  }
</style>
