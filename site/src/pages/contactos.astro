---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { gallery } from '../data/gallery';
---
<BaseLayout title="Contactos" description="Fale com a Casa da Bivó Mafalda para informações e reservas. Telefone 933 530 715. Encontre-nos na Av. António Silva, 2, Pinheiros, Tabuaço, no Douro." path="/contactos.html">
  <PageIntro title="Vamos combinar a sua visita?" description="Para informações e reservas, fale directamente connosco. Será um gosto recebê-lo na Casa da Bivó Mafalda." />
  <section class="container contact-section" aria-labelledby="contact-title">
    <div class="contact-details">
      <h2 id="contact-title">Estamos deste lado.</h2>
      <p>Para reservas por favor utilize os contactos abaixo indicados.</p>
      <div class="contact-method">
        <Icon name="phone" size={24} />
        <div><h3>Telefone</h3><ul>{site.phones.map((phone) => <li><a href={phone.href}>{phone.label}</a></li>)}</ul><small>Chamadas para a rede móvel nacional.</small></div>
      </div>
      <div class="contact-method">
        <Icon name="mail" size={24} />
        <div><h3>Email</h3><a class="email-address" href={`mailto:${site.email}`}>{site.email}</a></div>
      </div>
      <div class="contact-method">
        <Icon name="pin" size={24} />
        <div><h3>Morada</h3><address>{site.address}<br />{site.locality}<br />Portugal</address><a class="text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Abrir no Google Maps <Icon name="diagonal" size={16} /></a></div>
      </div>
    </div>
    <figure class="contact-photo"><Image src={gallery[0].image} alt={gallery[0].alt} widths={[400, 700, 970]} sizes="(max-width: 800px) 90vw, 45vw" loading="eager" /><figcaption class="photo-caption">A casa espera por si, no centro de Pinheiros.</figcaption></figure>
  </section>
  <section class="location-section" aria-labelledby="location-title">
    <div class="container">
      <div class="location-heading">
        <h2 id="location-title">O caminho até nós.</h2>
        <p>A Casa da Bivó Mafalda está situada em Pinheiros, Tabuaço, a cerca de 120km do Porto (2h), 29km da Régua (20min) e 14km do Rio Douro (10min).</p>
      </div>
      <div class="map-frame">
        <iframe title="Localização da Casa da Bivó Mafalda em Pinheiros, Tabuaço — OpenStreetMap" src="https://www.openstreetmap.org/export/embed.html?bbox=-7.6305%2C41.0925%2C-7.5925%2C41.1125&amp;layer=mapnik&amp;marker=41.1024187%2C-7.6116245" loading="lazy" referrerpolicy="no-referrer" allowfullscreen></iframe>
      </div>
      <div class="map-caption"><p>GPS: 41.1024187, -7.6116245</p><a href="https://www.openstreetmap.org/?mlat=41.1024187&mlon=-7.6116245#map=15/41.10242/-7.61162" target="_blank" rel="noopener noreferrer">Ver mapa maior · © OpenStreetMap contributors</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 6vw, 6rem); padding-bottom: 5rem; align-items: start; }
  .contact-details h2 { font-size: 2rem; }
  .contact-details > p { font-size: .85rem; color: var(--muted); margin: 1rem 0 2rem; max-width: 43ch; }
  .contact-method { display: flex; gap: 1.2rem; align-items: flex-start; border-top: 1px solid var(--line); padding-block: 1.5rem; }
  .contact-method > svg { margin-top: .2rem; }
  .contact-method h3 { font-family: var(--font-body); font-size: .75rem; color: var(--muted); letter-spacing: 0; margin-bottom: .65rem; font-weight: 500; }
  .contact-method ul { list-style: none; padding: 0; margin: 0 0 .4rem; }
  .contact-method li a { font-size: 1.3rem; text-decoration: none; font-weight: 500; }
  .contact-method small { font-size: .65rem; color: var(--muted); }
  .email-address { font-size: clamp(.72rem, 1.2vw, .95rem); overflow-wrap: anywhere; }
  .contact-method > div { min-width: 0; }
  address { font-size: .9rem; font-style: normal; }
  .contact-method .text-link { font-size: .75rem; margin-top: 1rem; }
  .contact-photo img { width: 100%; aspect-ratio: .85; object-fit: cover; object-position: 45%; border-radius: var(--radius); }
  .location-section { background: var(--mist); padding-block: 4rem; }
  .location-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; margin-bottom: 2rem; }
  .location-heading h2 { font-size: clamp(2rem, 3vw, 2.8rem); }
  .location-heading p { max-width: 53ch; font-size: .85rem; color: var(--muted); }
  .map-frame { height: 420px; border-radius: var(--radius); overflow: hidden; background: var(--leaf); }
  iframe { width: 100%; height: 100%; border: 0; }
  .map-caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; font-size: .65rem; color: var(--muted); margin-top: 1rem; }
  .map-caption p { font-variant-numeric: tabular-nums; }
  @media (max-width: 800px) {
    .contact-section { grid-template-columns: 1fr; gap: 2rem; padding-bottom: 3rem; }
    .contact-photo img { aspect-ratio: 1.4; }
    .location-heading { grid-template-columns: 1fr; gap: 1.25rem; }
    .map-frame { height: 350px; }
  }
</style>
